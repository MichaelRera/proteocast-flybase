{
  "manifest_version": 3,
  "name": "ProteoCast for FlyBase",
  "version": "0.3.0",
  "description": "Overlays ProteoCast missense-variant predictions on FlyBase protein, gene and allele pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://flybase.org/*",
    "https://api.flybase.org/*",
    "https://proteocast.ijm.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flybase.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "ProteoCast for FlyBase (click for settings)"
  }
}
