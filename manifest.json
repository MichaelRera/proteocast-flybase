{
  "manifest_version": 3,
  "name": "ProteoCast for FlyBase",
  "version": "0.3.2",
  "description": "Overlays ProteoCast missense-variant predictions on FlyBase protein, gene and allele pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://flybase.org/*",
    "https://api.flybase.org/*",
    "https://proteocast.ijm.fr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://flybase.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "ProteoCast for FlyBase (click for settings)"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "proteocast-flybase@proteocast.ijm.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
